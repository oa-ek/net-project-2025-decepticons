@using Microsoft.AspNetCore.Identity
@using ShubkivTour.Models.Entity

@inject SignInManager<Client> SignInManager
@inject UserManager<Client> UserManager

@model ShubkivTour.Models.DTO.TourDTOCreate
@{
	ViewData["Title"] = "Список турів";
}
<link rel="stylesheet" href="~/css/tour-list.css" />

<div class="container my-4">
	@if (TempData["SuccessMessage"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["SuccessMessage"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h1>Список турів</h1>
		@if (User.IsInRole("Admin"))
		{
			<a asp-controller="Tour" asp-action="TourAdd" class="btn btn-success">Створити новий тур</a>
		}
	</div>
	<div class="row">
		@foreach (var tour in ViewBag.AllTours as List<ShubkivTour.Models.Entity.Tour>)
		{
			<div class="col-md-4 col-sm-6 mb-4">
				<div class="tour-card">
					<div class="tour-card__image-container">
						@if (tour.Image != null)
						{
							<img src="~/@tour.Image.ImagePath" alt="Tour Image" class="tour-card__image" />
						}
						else
						{
							<div class="tour-card__no-image">Фото не додано</div>
						}

						<div class="tour-card__overlay">
							<a asp-controller="Tour" asp-action="TourDetails" asp-route-id="@tour.Id" class="tour-card__button">Переглянути</a>
						</div>

						<div class="tour-card__info-blur">
							<h5 class="tour-card__title">@tour.Name</h5>
							<p class="tour-card__date">@tour.Date.ToString("dd.MM.yyyy")</p>
						</div>
					</div>

					<div class="tour-card__body">
						<p>
							<strong>Складність:</strong> @tour.Complexity<br />
							<strong>Ціна:</strong> @tour.Price<br />
							<strong>Учасники:</strong> @tour.MaxMembers
						</p>

						@if (User.IsInRole("Admin"))
						{
							<div class="d-flex flex-wrap gap-1">
								<form asp-controller="Tour" asp-action="RemoveTour" asp-route-id="@tour.Id" method="post">
									<button type="submit" class="btn btn-danger btn-sm">Видалити</button>
								</form>
								<form asp-controller="Tour" asp-action="TourClient" asp-route-id="@tour.Id" method="get">
									<button type="submit" class="btn btn-success btn-sm">Учасники</button>
								</form>
							</div>
						}
						<a asp-controller="Tour" asp-action="Pay" asp-route-tourId="@tour.Id" class="btn btn-primary btn-sm mt-2" target="_blank">Зареєструватися</a>
					</div>
				</div>
			</div>
		}
	</div>
</div>

<div class="background-video">
	<video autoplay muted loop playsinline>
		<source src="~/video/tour-background.mp4" type="video/mp4">
		Ваш браузер не підтримує відео.
	</video>
</div>
