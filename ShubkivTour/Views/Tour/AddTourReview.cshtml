@using ShubkivTour.Models.DTO;
@model ReviewViewModel
@{
    ViewData["Title"] = "Залишити відгук";
    Layout = null;
}

<link rel="stylesheet" href="~/css/leaveComment.css" />

<div class="container-box">
    <h2>Залишити відгук</h2>
    <form asp-action="SubmitReview" method="post">
        <input type="hidden" asp-for="TourId" />

        <div class="form-group">
            <label asp-for="ReviewerName" class="control-label">Ваше ім’я</label>
            <input asp-for="ReviewerName" class="form-control" />
            <span asp-validation-for="ReviewerName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Comment" class="control-label">Ваш відгук</label>
            <textarea asp-for="Comment" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Надіслати відгук</button>
    </form>
</div>
