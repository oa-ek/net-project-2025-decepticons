@model ShubkivTour.Models.Entity.Tour;

<h2>Програма туру: @Model.Name</h2>

@if (Model.TourProgram != null && Model.TourProgram.Days.Any())
{
    <ul>
        @foreach (var day in Model.TourProgram.Days)
        {
            <li>
                <h3>День @day.DayNumber</h3>
                @if (day.Events.Any())
                {
                    <ul>
                        @foreach (var eventItem in day.Events)
                        {
                            <li>
                                <strong>@eventItem.Name</strong> - @eventItem.Description <br />
                                <em>Час: @eventItem.Time</em>
                                @if (eventItem.Image != null)
                                {
                                    <img src="@Url.Content("~/" + eventItem.Image.ImagePath)" class="img-thumbnail" style="max-width: 400px;" />
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>Подій немає</p>
                }
            </li>
        }
    </ul>
}
else
{
    <p>Днів у цьому турі ще немає</p>
}

@if (Model.MaxMembers > 0)
{
    var currentCount = Model.TourClients?.Count ?? 0;
    var percent = (int)(((double)currentCount / Model.MaxMembers) * 100);

    <div class="mb-3">
        <label>Заповненість туру: @currentCount / @Model.MaxMembers</label>
        <div class="progress">
            <div class="progress-bar bg-success" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                @percent%
            </div>
        </div>
    </div>
    <a asp-controller="Tour" asp-action="Pay" asp-route-tourId="@Model.Id" class="btn btn-info" target="_blank">
        Зареєструватися
    </a>
}
<a asp-controller="Tour" asp-action="TourLook" class="btn btn-primary">Назад</a>
