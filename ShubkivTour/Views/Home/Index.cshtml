@using ShubkivTour.Models.Entity;
@model IEnumerable<ShubkivTour.Models.Entity.Tour>
@{
	ViewData["Title"] = "Home Page";
	Layout = "_TopMenu";
}

<!DOCTYPE html>
<html lang="uk">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@ViewData["Title"]</title>

	<!-- CSS -->

	<!-- JS -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<!--=============== FAVICON ===============-->
	<link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">

	<!--=============== REMIXICONS ===============-->
	<link href="https://cdn.jsdelivr.net/npm/remixicon@3.2.0/fonts/remixicon.css" rel="stylesheet"

	<link rel="stylesheet" href="~/css/styler.css">
</head>
<body>
	<!--==================== HEADER ====================-->
	<header class="header" id="header">
	</header>

	<!--==================== MAIN ====================-->
	<main class="main">
		<!--==================== HOME ====================-->
		<section class="home section" id="home">
			<img src="~/img/gory_kordilery_nebo_95556_3840x2400.jpg" alt="home img" class="home__bg" />
			<div class="home__shadow"></div>

			<div class="home__container container grid">
				<div class="home__data">
					<h3 class="home__subtitle">
						Welcome to ShubkivTour
					</h3>

					<h1 class="home__title">
						Відкривайте світ
					</h1>Живіть подорожами, досліджуючи світ, відкривайте
					райські куточки, острови, гори та багато іншого
					більше, отримайте свою подорож зараз.
					</p>
					<a href="#" class="button">
						Почніть свою пригоду <i class="ri-arrow-right-line"></i>
					</a>
				</div>
				<h2 class="section__title">
					Найближчі тури
				</h2>
				<div class="home__cards grid">
					@foreach (var tour in Model)
					{
						<article class="home__card">
							<img src="~/@tour.Image.ImagePath" alt="home image" class="home__card-img" />
							<div class="home__card-shadow"></div>

							<div class="home__card-content">
								<h3 class="home__card-title">@tour.Name</h3>
								<p class="home__card-date">@tour.Date.ToString("dd.MM.yyyy")</p>
								<a asp-controller="Tour" asp-action="TourDetails" asp-route-id="@tour.Id" class="home__card-button">Переглянути</a>
							</div>
						</article>
					}
				</div>

			</div>
		</section>

		<!--==================== ABOUT ====================-->
		<section class="about section" id="about">
			<div class="about__container container grid">
				<div class="about__data">
					<h2 class="section__title">
						Дізнайтесь більше<br>
						Про подорожі
					</h2>

					<p class="about__description">
						Всі мандрівки по світу - це чудово
						задоволення щастя для будь-кого, насолоджуйся
						пам'ятки, коли ви подорожуєте світом. Подорожі
						безпечно та без турбот, отримайте свою поїздку та
						досліджувати райські куточки світу.
					</p>

					<a href="#" class="button">
						Досліджуйте подорожі <i class="ri-arrow-right-line"></i>
					</a>
				</div>

				<div class="about__image">
					<img src="~/img/vovka.jpg" alt="about image" class="about__img" />
					<div class="about__shadow"></div>
				</div>

			</div>

		</section>

		<!--==================== POPULAR ====================-->
		<section class="popular section" id="popular">
			<h2 class="section__title">
				Насолоджуйся красою <br>
				Світу
			</h2>

			<div class="popular__container container grid">
				<article class="popular__card">
					<div class="popular__image">
						<img src="~/img/nesamovyte.jpg" alt="popular image" class="popular__img" />
						<div class="popular__shadow"></div>
					</div>

					<h2 class="popular__title">
						Несамовите
					</h2>

					<div class="popular__location">
						<i class="ri-map-pin-line"></i>
						<span>Івано-Франківськ</span>
					</div>
				</article>
				<article class="popular__card">
					<div class="popular__image">
						<img src="~/img/водоспад-гук.jpg" alt="popular image" class="popular__img" />
						<div class="popular__shadow"></div>
					</div>

					<h2 class="popular__title">
						Водоспад "Гук"
					</h2>

					<div class="popular__location">
						<i class="ri-map-pin-line"></i>
						<span>Івано-Франківськ</span>
					</div>
				</article>
				<article class="popular__card">
					<div class="popular__image">
						<img src="~/img/говерла.jpg" alt="popular image" class="popular__img" />
						<div class="popular__shadow"></div>
					</div>

					<h2 class="popular__title">
						Говерла
					</h2>

					<div class="popular__location">
						<i class="ri-map-pin-line"></i>
						<span>Івано-Франківськ</span>
					</div>
				</article>
			</div>
		</section>

		<!--==================== EXPLORE ====================-->
		<section class="explore section" id="explore">
			<div class="explore__container">
				<div class="explore__image">
					<img src="~/img/2e915a26-2de9-4b5a-9e81-9f0ab25ca965.jpg" alt="explore image" class="explore__img" />
					<div class="explore__shadow"></div>
				</div>

				<div class="explore__content container grid">
					<div class="explore__data">
						<h2 class="section__title">
							Дослідіть<br>
							Світ
						</h2>
						<p class="explore__description">
							Світ — прекрасне місце, повне
							дива та пригоди чекають
							виявлено. З величних гір
							до тихих пляжів, кожен куточок
							світ може запропонувати щось унікальне.
						</p>

					</div>

					<div class="explore__user">
						<img src="~/img/photo_2023-09-19_20-27-43.jpg" alt="explore image" class="explore__perfil" />
						<span class="explore__name">Дмитро Долженко</span>
					</div>
				</div>
			</div>
		</section>

		<!--==================== REVIEWS ====================-->
		<section>
			<div class="review-slider-container">
				<h2 class="text-center text-light mb-4">Відгуки про нас</h2>

				<div id="reviewCarousel" class="carousel slide" data-bs-ride="carousel">
					<div class="carousel-inner">
						@{
							var reviews = (IEnumerable<Review>)ViewBag.Reviews;
							var reviewGroups = reviews.Select((review, index) => new { review, index })
							.GroupBy(x => x.index / 3)
							.Select(g => g.Select(x => x.review));

							bool isFirst = true;
							foreach (var group in reviewGroups)
							{
								<div class="carousel-item @(isFirst ? "active" : "")">
									<div class="d-flex justify-content-center gap-3 flex-wrap">
										@foreach (var review in group)
										{
											<div class="card text-center p-3" style="width: 18rem; background-color: #181818">
												<div class="card-body">
													<h5 class="card-title">@review.ReviewerName</h5>
													<p class="card-text">"@review.Comment"</p>
													<p class="text-muted">@review.Date.ToString("dd.MM.yyyy")</p>
												</div>
											</div>
										}
									</div>
								</div>
								isFirst = false;
							}
						}
					</div>

					<button class="carousel-control-prev" type="button" data-bs-target="#reviewCarousel" data-bs-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="visually-hidden">Previous</span>
					</button>
					<button class="carousel-control-next" type="button" data-bs-target="#reviewCarousel" data-bs-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="visually-hidden">Next</span>
					</button>
				</div>
			</div>
		</section>

		<!--==================== JOIN ====================-->
		<section class="join section">
			<div class="join__container container grid">
				<div class="join__data">
					<h2 class="section__title">
						Приєднуйся до<br>
						Пригод
					</h2>
					<p class="join__description">
						Приєднуйтесь до нас у незабутню подорож
						через найзахоплюючі краєвиди
						і яскраві культури.
					</p>

					<form action="" class="join__form">
						<input type="email" placeholder="Введіть адресу електронної пошти" class="join__input" />

						<button class="join__button button">
							Підпишіться на нашу розсилку<i class="ri-arrow-right-line"></i>
						</button>
					</form>
				</div>

				<div class="join__image">
					<img src="~/img/Buka.jpg" alt="join image" class="join__img" />
					<div class="join__shadow"></div>
				</div>

			</div>
		</section>
	</main>

	<!--==================== FOOTER ====================-->
	<footer class="footer">
		<div class="footer__container container grid">
			<div class="footer__content grid">
				<div>
					<a href="#" class="footer__logo">Подорожі</a>

					<p class="footer__description">
						Подорожуйте та досліджуйте <br>
						світ з нами.
					</p>
				</div>

				<div class="footer__data grid">
					<div>
						<h3 class="footer__title">Інформація</h3>

						<ul class="footer__links">
							<li>
								<a href="#" class="footer__link">Про нас</a>
							</li>
							<li>
								<a href="#" class="footer__link">Особливості</a>
							</li>
							<li>
								<a href="#" class="footer__link">Новини та блог</a>
							</li>
						</ul>
					</div>

					<div>
						<h3 class="footer__title">Компанія</h3>

						<ul class="footer__links">
							<li>
								<a href="#" class="footer__link">FAQs</a>
							</li>
							<li>
								<a href="#" class="footer__link">Історія</a>
							</li>
							<li>
								<a href="#" class="footer__link">Відгуки</a>
							</li>
						</ul>
					</div>

					<div>
						<h3 class="footer__title">Contact</h3>

						<ul class="footer__links">
							<li>
								<a href="#" class="footer__link">Кол-центр</a>
							</li>
							<li>
								<a href="#" class="footer__link">Центр підтримки</a>
							</li>
							<li>
								<a href="#" class="footer__link">Зв'яжіться з нами</a>
							</li>
						</ul>
					</div>

					<div>
						<h3 class="footer__title">Підтримка</h3>

						<ul class="footer__links">
							<li>
								<a href="#" class="footer__link">Політика конфіденційності</a>
							</li>
							<li>
								<a href="#" class="footer__link">Умови та послуги</a>
							</li>
							<li>
								<a href="#" class="footer__link">Платежі</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
			<div class="footer__group">
				<div class="footer__social">
					<a href="https://www.facebook.com/?locale=uk_UA" target="_blank" class="footer__social-link">
						<i class="ri-facebook-line"></i>
					</a>
					<a href="https://www.instagram.com" target="_blank" class="footer__social-link">
						<i class="ri-instagram-line"></i>
					</a>
					<a href="https://t.me/dolzhenko43" target="_blank" class="footer__social-link">
						<i class="ri-telegram-line"></i>
					</a>
					<a href="https://www.youtube.com" target="_blank" class="footer__social-link">
						<i class="ri-youtube-line"></i>
					</a>
				</div>

				<span class="footer__copy">
					&#169; 2023 ShubkivTour. All rights reserved.
			</div>
		</div>
	</footer>

	<!--========== SCROLL UP ==========-->
	<a href="#" class="scrollup" id="scroll-up">
		<i class="ri-arrow-up-line"></i>
	</a>
	<!--=============== SCROLLREVEAL ===============-->
	<script src="~/js/scrollreveal.min.js"></script>

	<!--=============== MAIN JS ===============-->
	<script src="assets/js/main.js"></script>

	<script src="~/js/main.js" asp-append-version="true"></script>
</body>
</html>

<script>
	let currentSlide = 0;

	function updateSlider() {
		const slider = document.querySelector('.review-slider');
		const slides = document.querySelectorAll('.review-slide');
		const totalSlides = slides.length;
		if (currentSlide < 0) currentSlide = totalSlides - 1;
		if (currentSlide >= totalSlides) currentSlide = 0;

		slider.style.transform = `translateX(-${currentSlide * 100}%)`;
	}

	function nextReview() {
		currentSlide++;
		updateSlider();
	}

	function prevReview() {
		currentSlide--;
		updateSlider();
	}

	// Optional: auto-slide
	// setInterval(() => {
	//     nextReview();
	// }, 8000);
</script>
