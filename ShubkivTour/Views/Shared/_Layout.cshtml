@using Microsoft.AspNetCore.Identity
@using ShubkivTour.Models.Entity

@inject SignInManager<Client> SignInManager
@inject UserManager<Client> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShubkivTour</title>
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
</head>
<body>
    <div class="layout-wrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="head">
                <div class="user-img">
                    <img src="~/img/user.png" alt="User" />
                </div>
                <div class="user-details">
                    <p class="title">Logged in as</p>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        <p class="name">@user?.UserName</p>
                    }
                    else
                    {
                        <p class="name">Гість</p>
                    }
                </div>
            </div>

            <div class="nav">
                <div class="menu">
                    <p class="title">Main</p>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="icon"></i>
                                <span class="text">Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tour" asp-action="TourLook">
                                <i class="icon"></i>
                                <span class="text">Тури</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Guide" asp-action="GuideLook">
                                    <i class="icon"></i>
                                    <span class="text">Гіди</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalog" asp-action="Index">
                                <i class="icon"></i>
                                <span class="text">Каталог</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="mt-auto">
                <partial name="_LoginPartial" />
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
